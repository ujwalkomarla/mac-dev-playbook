model_list:
{% for m in studio_router_models %}
  - model_name: "{{ m.name }}"
    litellm_params:
      model: "openai/{{ m.name }}"
      api_base: http://127.0.0.1:{{ studio_ports.router }}/v1
      api_key: os.environ/ROUTER_API_KEY
{% endfor %}

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
