<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ item.label }}</string>
  <key>ProgramArguments</key>
  <array>
{% for arg in item.args %}
    <string>{{ arg | e }}</string>
{% endfor %}
  </array>
{% if item.user | default('') %}
  <key>UserName</key>
  <string>{{ item.user }}</string>
{% endif %}
{% if item.env | default({}) %}
  <key>EnvironmentVariables</key>
  <dict>
{% for k, v in item.env.items() %}
    <key>{{ k }}</key>
    <string>{{ v }}</string>
{% endfor %}
  </dict>
{% endif %}
  <key>RunAtLoad</key>
  <true/>
{% if item.keep_alive | default(true) %}
  <key>KeepAlive</key>
  <true/>
{% endif %}
{% if item.log | default('') %}
  <key>StandardOutPath</key>
  <string>{{ studio_log_dir }}/{{ item.log }}.log</string>
  <key>StandardErrorPath</key>
  <string>{{ studio_log_dir }}/{{ item.log }}.log</string>
{% endif %}
</dict>
</plist>
